/run/initialize

/vis/open OGL 1000x800-0+0
/vis/verbose warnings
/vis/viewer/set/background 0 0 0
/vis/drawVolume
/vis/viewer/set/viewpointVector -1 -1 0.7
/vis/viewer/set/upVector 0 0 1
/vis/viewer/zoom 1.25
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/lineSegmentsPerCircle 96

/vis/scene/add/axes 0 0 0 150 mm
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set proton green
/vis/modeling/trajectories/drawByParticleID-0/set gamma cyan
/vis/modeling/trajectories/drawByParticleID-0/set e- yellow
/vis/scene/endOfEventAction accumulate
/vis/scene/add/hits

# A few proton tracks for display only. The production run is in run_proton.mac.
/gps/particle proton
/gps/energy 90 MeV
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/halfx 8 mm
/gps/pos/halfy 8 mm
/gps/pos/rot1 0 1 0
/gps/pos/rot2 0 0 1
/gps/pos/centre 160 0 0 mm
/gps/direction -1 0 0

/run/beamOn 30
/vis/viewer/flush
