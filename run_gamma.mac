/run/initialize

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# Gamma reference beam. It uses the same beam spot and direction as the proton
# case so Cancer/Normal spectra can be compared directly.
/gps/particle gamma
/gps/energy 6 MeV
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/halfx 8 mm
/gps/pos/halfy 8 mm
/gps/pos/rot1 0 1 0
/gps/pos/rot2 0 0 1
/gps/pos/centre 160 0 0 mm
/gps/direction -1 0 0

/run/beamOn 1000
